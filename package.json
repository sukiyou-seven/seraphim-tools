{
  "name": "seraphim-tools",
  "productName": "Seraphim Tools",
  "version": "1.0.0",
  "description": "跨平台开发者工具箱（Electron 版）：二维码 / 编解码 / 加密 / 单位换算 / 生成器 / 开发辅助 / 网络 / 取色 / 提示词 / 鼠标连点",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "author": {
    "name": "sukiyou-seven",
    "email": "s844562300@163.com"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4"
  },
  "build": {
    "appId": "com.sukiyou-seven.seraphim-tools",
    "productName": "Seraphim Tools",
    "directories": {
      "output": "dist"
    },
    "artifactName": "SeraphimTools-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/@nut-tree-fork/**"
    ],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.utilities",
      "identity": null,
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ]
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "linux": {
      "category": "Utility",
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ]
    }
  }
}
